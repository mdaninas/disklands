{
  "name": "disklands-desktop",
  "version": "1.3.0",
  "description": "A desktop app to explore local disk usage.",
  "author": "Disklands",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "package": "node scripts/generate-icon.cjs && npm run build && node scripts/package.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0"
  },
  "build": {
    "appId": "id.disklands.desktop",
    "productName": "Disklands",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Disklands-${version}-Windows.exe"
    }
  }
}
